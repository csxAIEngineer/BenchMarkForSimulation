# Copy to .env. .env is gitignored and is never read into the dataset cache.

# Mock 路径不需要密钥：benchmark simulate --provider mock

# OpenAI 兼容接口（OpenAI 或 DeepSeek）。comms.providers.openai_compat 使用。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# CR API。comms.providers.cr 转给仓库里的 cr_api.CRClient。
# https://api.creative-reasoning.com
CR_API_KEY=
