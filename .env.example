# Copy to .env. .env is gitignored.

# CR API, used by cr_api.CRClient for gpt-5.5, glm-5.3, and deepseek-v4-pro.
# https://api.creative-reasoning.com
CR_API_KEY=

# DeepSeek API. `simulate-population-personas` writes ATUS adult cards with DEEPSEEK_MODEL.
# `compare` and `compare-categories` take `--models` on the CR API instead.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
