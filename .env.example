# Copy to .env. .env is gitignored.

# CR API, used by cr_api.CRClient for gpt-5.5, glm-5.3, and deepseek-v4-pro.
# https://api.creative-reasoning.com
CR_API_KEY=

# Default single-model path (no --model). Not used by `popbench compare`.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
